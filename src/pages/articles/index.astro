---
import Base from '../../layouts/Base.astro';
import ListView from '../../components/ListView.astro';
import { getPublished, pageUrl } from '../../utils/articles';
import { PAGE_SIZE } from '../../consts';

const all = await getPublished();
const totalPages = Math.max(1, Math.ceil(all.length / PAGE_SIZE));
---

<Base title="文章">
  <div class="masthead">
    <h1>文章</h1>
    <p class="masthead__sub">
      全部 {all.length} 篇，按时间倒序。想看更紧凑的列表就去<a
        href="/archive/"
        style="color:var(--accent)">归档</a
      >。
    </p>
    <div class="masthead__rule"></div>
  </div>

  <ListView
    articles={all.slice(0, PAGE_SIZE)}
    currentPage={1}
    totalPages={totalPages}
    nextUrl={totalPages > 1 ? pageUrl('/articles/', 2) : undefined}
    emptyTitle="还没有文章。"
    emptyHint="第一篇写出来之后，这里会开始有东西。"
  />
</Base>
