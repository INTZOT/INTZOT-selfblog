---
import type { GetStaticPaths } from 'astro';
import Base from '../../../layouts/Base.astro';
import ListView from '../../../components/ListView.astro';
import { getPublished, pageUrl, type Article } from '../../../utils/articles';
import { PAGE_SIZE } from '../../../consts';

interface Props {
  page: {
    data: Article[];
    currentPage: number;
    totalPages: number;
    url: { current: string; prev?: string; next?: string };
  };
}

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const all = await getPublished();
  const pages = paginate(all, { pageSize: PAGE_SIZE });
  return pages.filter((entry) => (entry.props as unknown as Props).page.currentPage > 1);
};

const { page } = Astro.props;
const base = '/articles/';
---

<Base title="文章">
  <div class="masthead">
    <div class="masthead__kicker"><b>第 {page.currentPage} 页</b><span>共 {page.totalPages} 页</span></div>
    <h1>文章</h1>
  </div>

  <div class="section-head"><h2>更早</h2></div>

  <ListView
    articles={page.data}
    currentPage={page.currentPage}
    totalPages={page.totalPages}
    prevUrl={pageUrl(base, page.currentPage - 1)}
    nextUrl={page.currentPage < page.totalPages ? pageUrl(base, page.currentPage + 1) : undefined}
  />
</Base>
