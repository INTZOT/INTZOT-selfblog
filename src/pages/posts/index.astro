---
import Base from '../../layouts/Base.astro';
import ListView from '../../components/ListView.astro';
import { byKind, getPublished, pageUrl } from '../../utils/articles';
import { PAGE_SIZE } from '../../consts';

const all = byKind(await getPublished(), 'posts');
const totalPages = Math.max(1, Math.ceil(all.length / PAGE_SIZE));
---

<Base title="技术">
  <div class="masthead">
    <h1>技术</h1>
    <p class="masthead__sub">共  篇。解决某个问题之后的复盘。{all.length} 篇。解决某个问题之后的复盘。</p>
    <div class="masthead__rule"></div>
  </div>

  <ListView
    articles={all.slice(0, PAGE_SIZE)}
    currentPage={1}
    totalPages={totalPages}
    nextUrl={totalPages > 1 ? pageUrl('/posts/', 2) : undefined}
    emptyTitle="还没有技术笔记。"
    emptyHint="第一篇写出来之后，这里会开始有东西。"
  />
</Base>
