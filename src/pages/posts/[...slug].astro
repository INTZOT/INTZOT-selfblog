---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { seriesNav } from '../../utils/articles';

export async function getStaticPaths() {
  const all = await getCollection('articles', ({ data }) => !data.draft);
  const prefix = 'posts/';
  return all
    .filter((article) => article.id.startsWith(prefix))
    .map((article) => ({
      params: { slug: article.id.slice(prefix.length) },
      props: { article, series: seriesNav(all, article) },
    }));
}

const { article, series } = Astro.props;
const { Content } = await render(article);
---

<ArticleLayout article={article} series={series}>
  <Content />
</ArticleLayout>
