---
import Base from '../../layouts/Base.astro';
import { countTags, getPublished, tagUrl } from '../../utils/articles';
import { KIND_TAGS } from '../../consts';

const all = await getPublished();
const tags = countTags(all);

// 体裁标签（技术 / 随笔）单独一块：它们是「这是什么」，不是「关于什么」，
// 混在主题标签里会让标签云失去意义。
const kindSet = new Set<string>(KIND_TAGS);
const kinds = tags.filter(([tag]) => kindSet.has(tag));
const topics = tags.filter(([tag]) => !kindSet.has(tag));
---

<Base title="标签">
  <div class="masthead">
    <h1>标签</h1>
    <p class="masthead__sub">
      共 {tags.length} 个标签、{all.length} 篇文章。按使用频次排序。
    </p>
    <div class="masthead__rule"></div>
  </div>

  {
    kinds.length > 0 && (
      <>
        <div class="section-head">
          <h2>体裁</h2>
        </div>
        <ul class="tag-grid tag-grid--kinds">
          {kinds.map(([tag, count]) => (
            <li>
              <a href={tagUrl(tag)}>
                <span class="name">{tag}</span>
                <span class="c">{count}</span>
              </a>
            </li>
          ))}
        </ul>
      </>
    )
  }

  <div class="section-head">
    <h2>主题</h2>
  </div>
  {
    topics.length > 0 ? (
      <ul class="tag-grid">
        {topics.map(([tag, count]) => (
          <li>
            <a href={tagUrl(tag)}>
              <span class="name">{tag}</span>
              <span class="c">{count}</span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="year__empty">还没有主题标签。文章里写上的标签会出现在这里。</p>
    )
  }
</Base>
