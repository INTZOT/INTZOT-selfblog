---
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import avatar from '../assets/avatar.jpg';
import { SITE } from '../consts';
import { countTags, getPublished } from '../utils/articles';

// 正文来自 content/about.md —— 读者看到的那些话不该埋在模板里，
// 放在 Markdown 里就能用写文章的方式改（含 GitHub 网页编辑器）。
const entry = await getEntry('pages', 'about');
if (!entry) {
  throw new Error('找不到 content/about.md —— 关于页的正文来自它。');
}
const { Content } = await render(entry);

const all = await getPublished();
const tags = countTags(all);
---

<Base title="关于" description={SITE.description}>
  <div class="masthead">
    <h1>{entry.data.title}</h1>
    <p class="masthead__sub">这个博客是什么，为什么存在，以及它是怎么做出来的。</p>
    <div class="masthead__rule"></div>
  </div>

  <div class="about">
    <div class="about__main">
      <Image
        class="about__avatar"
        src={avatar}
        alt={SITE.author + ' 的头像'}
        width={208}
        height={208}
        loading="eager"
        decoding="async"
      />
      <div class="prose about__prose">
        <Content />
      </div>
    </div>

    <dl class="about__facts">
      <dt>作者</dt><dd>{SITE.author}</dd>
      <dt>开始于</dt><dd>{SITE.since}</dd>
      <dt>文章数</dt><dd>{all.length}</dd>
      <dt>标签数</dt><dd>{tags.length}</dd>
      <dt>写作方式</dt><dd>Markdown，存在 Git 仓库里</dd>
      <dt>评论</dt><dd>没有。想说什么可以直接发邮件</dd>
      <dt>订阅</dt><dd><a href="/rss.xml">RSS</a></dd>
      <dt>联系</dt>
      <dd>
        <a href={'mailto:' + SITE.email}>{SITE.email}</a> · <a href={SITE.github}>GitHub</a>
      </dd>
    </dl>
  </div>
</Base>
