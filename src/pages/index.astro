---
import Base from '../layouts/Base.astro';
import HomeView from '../components/HomeView.astro';
import { countTags, getPublished, pageUrl } from '../utils/articles';
import { PAGE_SIZE } from '../consts';

const all = await getPublished();
const totalPages = Math.max(1, Math.ceil(all.length / PAGE_SIZE));
const hasHero = all.length > 0;
---

<Base full overlay={hasHero}>
  <HomeView
    masthead={{ total: all.length, tagCount: countTags(all).length }}
    articles={all.slice(0, PAGE_SIZE)}
    currentPage={1}
    totalPages={totalPages}
    nextUrl={totalPages > 1 ? pageUrl('/', 2) : undefined}
  />
</Base>
