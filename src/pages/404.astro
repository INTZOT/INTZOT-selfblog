---
import Base from '../layouts/Base.astro';
import { NAV } from '../consts';
---

<Base title="404">
  <div class="notfound">
    <p class="notfound__code">404</p>
    <h1>这个地址上没有东西</h1>
    <p>
      可能是链接拼错了，也可能是我把某篇文章移走或删掉了。<br />
      下面这些地方也许能帮你找到它。
    </p>
  </div>

  <ul class="nav-list">
    {
      NAV.map((item) => (
        <li>
          <a href={item.href}>
            <span class="n">{item.label}</span>
            <span class="p">{item.href}</span>
          </a>
        </li>
      ))
    }
    <li>
      <a href="/search/">
        <span class="n">search</span>
        <span class="p">/search/</span>
      </a>
    </li>
  </ul>
</Base>
