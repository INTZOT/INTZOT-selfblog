---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import HomeView from '../../components/HomeView.astro';
import { countTags, getPublished, pageUrl, type Article } from '../../utils/articles';
import { PAGE_SIZE } from '../../consts';

interface Props {
  page: {
    data: Article[];
    currentPage: number;
    totalPages: number;
    url: { current: string; prev?: string; next?: string };
  };
  meta: { total: number; tagCount: number };
}

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const all = await getPublished();
  const pages = paginate(all, {
    pageSize: PAGE_SIZE,
    props: { meta: { total: all.length, tagCount: countTags(all).length } },
  });
  // 第 1 页由 src/pages/index.astro 负责，这里只生成第 2 页起
  return pages.filter((entry) => (entry.props as unknown as Props).page.currentPage > 1);
};

const { page, meta } = Astro.props;
---

<Base>
  <HomeView
    masthead={meta}
    articles={page.data}
    currentPage={page.currentPage}
    totalPages={page.totalPages}
    prevUrl={pageUrl('/', page.currentPage - 1)}
    nextUrl={page.currentPage < page.totalPages ? pageUrl('/', page.currentPage + 1) : undefined}
  />
</Base>
